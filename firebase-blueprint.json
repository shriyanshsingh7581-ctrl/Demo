{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "A customer makeup or salon appointment booking with Subba Lakshmi at Eden Roses Makeover.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier (e.g. ID-1473826)",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the customer",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number",
          "minLength": 5,
          "maxLength": 30
        },
        "whatsapp": {
          "type": "string",
          "description": "Customer WhatsApp number",
          "minLength": 5,
          "maxLength": 30
        },
        "address": {
          "type": "string",
          "description": "Complete event or home address in Bengaluru",
          "minLength": 3,
          "maxLength": 500
        },
        "locality": {
          "type": "string",
          "description": "Bengaluru locality name",
          "maxLength": 120
        },
        "eventType": {
          "type": "string",
          "description": "Type of event",
          "enum": ["Wedding", "Engagement", "Reception", "Party", "Photoshoot", "Other"],
          "maxLength": 40
        },
        "services": {
          "type": "array",
          "description": "List of booked service items (max 30 items)"
        },
        "date": {
          "type": "string",
          "description": "Appointment date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "time": {
          "type": "string",
          "description": "Appointment time slot (e.g. 08:00 AM)",
          "maxLength": 20
        },
        "itemsTotal": {
          "type": "number",
          "description": "Subtotal of all booked items in INR"
        },
        "discount": {
          "type": "number",
          "description": "Discount amount in INR"
        },
        "advancePaid": {
          "type": "number",
          "description": "Advance payment received in INR"
        },
        "amountToCollect": {
          "type": "number",
          "description": "Remaining balance to be collected in INR"
        },
        "notes": {
          "type": "string",
          "description": "Special notes or requests from the customer",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Current workflow status of the booking",
          "enum": [
            "Pending Verification",
            "Confirmed",
            "Assigned",
            "Visit Scheduled",
            "Journey Started",
            "In Progress",
            "Completed",
            "Cancelled",
            "Reported"
          ],
          "maxLength": 40
        },
        "paymentStatus": {
          "type": "string",
          "description": "Verification status of mandatory Rs 99 advance payment",
          "enum": ["Pending Verification", "Verified", "Rejected"],
          "maxLength": 40
        },
        "utrNumber": {
          "type": "string",
          "description": "UTR Number, Reference Number, or Transaction ID submitted by customer",
          "maxLength": 100
        },
        "paymentProofType": {
          "type": "string",
          "description": "Type of payment reference submitted (UTR Number, Reference Number, Transaction ID)",
          "maxLength": 50
        },
        "paymentScreenshot": {
          "type": "string",
          "description": "Uploaded payment screenshot URL or compressed DataURL",
          "maxLength": 600000
        },
        "bookingSource": {
          "type": "string",
          "description": "Origin channel of the booking",
          "enum": [
            "Customer Website",
            "Admin Manual",
            "Instagram",
            "WhatsApp",
            "Phone Call",
            "Walk-in"
          ],
          "maxLength": 40
        },
        "assignedTeam": {
          "type": "array",
          "description": "Assigned makeup and hairstyling team members"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO update timestamp",
          "maxLength": 50
        },
        "completedAt": {
          "type": "string",
          "description": "ISO completion timestamp",
          "maxLength": 50
        },
        "reportReason": {
          "type": "string",
          "description": "Reason if the job was reported",
          "maxLength": 500
        },
        "badgeType": {
          "type": "string",
          "description": "Partner app badge type",
          "enum": ["VISIT", "CALL", "FOLLOWUP", "JOB"],
          "maxLength": 20
        }
      },
      "required": [
        "id",
        "customerName",
        "phone",
        "whatsapp",
        "address",
        "eventType",
        "services",
        "date",
        "time",
        "itemsTotal",
        "discount",
        "advancePaid",
        "amountToCollect",
        "notes",
        "status",
        "bookingSource",
        "assignedTeam",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomerLead": {
      "title": "CustomerLead",
      "description": "Customer contact details, callback inquiry, or booking user record synced in real-time to the Admin Panel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique customer or inquiry ID",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number",
          "minLength": 5,
          "maxLength": 30
        },
        "whatsapp": {
          "type": "string",
          "description": "Customer WhatsApp number",
          "maxLength": 30
        },
        "address": {
          "type": "string",
          "description": "Customer address or locality in Bengaluru",
          "maxLength": 500
        },
        "locality": {
          "type": "string",
          "description": "Bengaluru locality",
          "maxLength": 120
        },
        "eventType": {
          "type": "string",
          "description": "Event type or inquiry category",
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "description": "Customer notes, inquiry message, or booked services summary",
          "maxLength": 1000
        },
        "lastBookingId": {
          "type": "string",
          "description": "Associated booking ID if created via booking form",
          "maxLength": 64
        },
        "totalSpend": {
          "type": "number",
          "description": "Total booking value in INR"
        },
        "source": {
          "type": "string",
          "description": "Source of customer lead (Booking Form, Callback Form, Admin)",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when customer details were submitted",
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "customerName",
        "phone",
        "whatsapp",
        "address",
        "eventType",
        "message",
        "source",
        "createdAt"
      ]
    },
    "BusinessSettingsDoc": {
      "title": "BusinessSettingsDoc",
      "description": "Global business profile, CMS content, promotional offers, banners, and studio settings for Eden Roses Makeover.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 150 },
        "makeupBrand": { "type": "string", "maxLength": 150 },
        "artistName": { "type": "string", "maxLength": 120 },
        "businessCategory": { "type": "string", "maxLength": 300 },
        "logoUrl": { "type": "string", "maxLength": 500000 },
        "footerLogoUrl": { "type": "string", "maxLength": 500000 },
        "phonePrimary": { "type": "string", "maxLength": 40 },
        "phoneSecondary": { "type": "string", "maxLength": 40 },
        "whatsappNumber": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 250 },
        "googleMapsLink": { "type": "string", "maxLength": 1000 },
        "openingHours": { "type": "string", "maxLength": 250 },
        "websiteUrl": { "type": "string", "maxLength": 250 },
        "instagramUrl": { "type": "string", "maxLength": 250 },
        "facebookUrl": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 3000 },
        "serviceArea": { "type": "string", "maxLength": 1000 },
        "heroImageUrl": { "type": "string", "maxLength": 500000 },
        "headerTagline": { "type": "string", "maxLength": 200 },
        "defaultCity": { "type": "string", "maxLength": 80 },
        "heroBannerTitle": { "type": "string", "maxLength": 160 },
        "heroBannerSubtitle": { "type": "string", "maxLength": 250 },
        "heroBannerTagline": { "type": "string", "maxLength": 250 },
        "heroCtaText": { "type": "string", "maxLength": 80 },
        "ratingScore": { "type": "string", "maxLength": 20 },
        "ratingCountText": { "type": "string", "maxLength": 60 },
        "trustBadgeTitle": { "type": "string", "maxLength": 150 },
        "trustBadgeSubtitle": { "type": "string", "maxLength": 250 },
        "offer1Title": { "type": "string", "maxLength": 150 },
        "offer1Code": { "type": "string", "maxLength": 40 },
        "offer1DiscountAmount": { "type": "number" },
        "offer2Title": { "type": "string", "maxLength": 150 },
        "offer2Code": { "type": "string", "maxLength": 40 },
        "offer2DiscountPercent": { "type": "number" },
        "aboutKicker": { "type": "string", "maxLength": 120 },
        "aboutHighlight1Title": { "type": "string", "maxLength": 80 },
        "aboutHighlight1Sub": { "type": "string", "maxLength": 160 },
        "aboutHighlight2Title": { "type": "string", "maxLength": 80 },
        "aboutHighlight2Sub": { "type": "string", "maxLength": 160 },
        "aboutHighlight3Title": { "type": "string", "maxLength": 80 },
        "aboutHighlight3Sub": { "type": "string", "maxLength": 160 },
        "blockedDates": { "type": "array" },
        "timeSlots": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["businessName", "makeupBrand", "artistName", "phonePrimary", "address"]
    },
    "ServiceItemDoc": {
      "title": "ServiceItemDoc",
      "description": "Makeup, hairstyling, saree draping, or salon product/service item with pricing managed from the Admin Panel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "makeupSubCategory": { "type": "string", "maxLength": 80 },
        "landingGroup": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1500 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "highlights": { "type": "array" },
        "whatsIncluded": { "type": "array" },
        "additionalInfo": { "type": "array" },
        "image": { "type": "string", "maxLength": 500000 },
        "isPackage": { "type": "boolean" },
        "airbrushAvailable": { "type": "boolean" },
        "duration": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "name", "category", "description", "image", "isPackage"]
    },
    "TeamMemberDoc": {
      "title": "TeamMemberDoc",
      "description": "Team member profile and Admin Panel login credentials (User ID and Password) managed by Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 40 },
        "active": { "type": "boolean" },
        "userId": { "type": "string", "maxLength": 80 },
        "password": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "role", "phone", "active"]
    },
    "GalleryItemDoc": {
      "title": "GalleryItemDoc",
      "description": "Portfolio gallery photograph synced in real time between Admin Panel and Customer Website.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "maxLength": 500000 },
        "alt": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 80 },
        "galleryCategory": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "displayPosition": { "type": "string", "maxLength": 80 }
      },
      "required": ["id", "url", "alt", "category"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Real-time makeup and salon appointments synced between Customer Website and Partner Admin App."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerLead" },
      "description": "Real-time customer contact details and inquiries synced to the Partner Admin Panel."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettingsDoc" },
      "description": "Business settings, website CMS content, offers, and configuration documents."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItemDoc" },
      "description": "Real-time product, package, and service pricing catalog synced between Admin Panel and Customer Website."
    },
    "/team/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMemberDoc" },
      "description": "Real-time team member accounts and login credentials managed from the Admin Panel."
    },
    "/gallery/{imageId}": {
      "schema": { "$ref": "#/entities/GalleryItemDoc" },
      "description": "Real-time portfolio gallery images synced between Admin Panel and Customer Website."
    }
  }
}
