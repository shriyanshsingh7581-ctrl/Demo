rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints
    function isValidBooking(data) {
      return data.keys().hasAll([
        'id',
        'customerName',
        'phone',
        'whatsapp',
        'address',
        'eventType',
        'services',
        'date',
        'time',
        'itemsTotal',
        'discount',
        'advancePaid',
        'amountToCollect',
        'notes',
        'status',
        'bookingSource',
        'assignedTeam',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'customerName',
        'phone',
        'whatsapp',
        'address',
        'locality',
        'eventType',
        'services',
        'date',
        'time',
        'itemsTotal',
        'discount',
        'advancePaid',
        'amountToCollect',
        'notes',
        'status',
        'bookingSource',
        'assignedTeam',
        'createdAt',
        'updatedAt',
        'completedAt',
        'reportReason',
        'badgeType'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
      data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
      data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30 &&
      data.whatsapp is string && data.whatsapp.size() <= 30 &&
      data.address is string && data.address.size() <= 500 &&
      (!('locality' in data) || (data.locality is string && data.locality.size() <= 120)) &&
      data.eventType is string && data.eventType.size() <= 40 &&
      data.eventType in ['Wedding', 'Engagement', 'Reception', 'Party', 'Photoshoot', 'Other'] &&
      data.services is list && data.services.size() <= 30 &&
      data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
      data.time is string && data.time.size() >= 1 && data.time.size() <= 20 &&
      data.itemsTotal is number && data.itemsTotal >= 0 &&
      data.discount is number && data.discount >= 0 &&
      data.advancePaid is number && data.advancePaid >= 0 &&
      data.amountToCollect is number && data.amountToCollect >= 0 &&
      data.notes is string && data.notes.size() <= 1000 &&
      data.status is string && data.status.size() <= 40 &&
      data.status in [
        'Confirmed',
        'Visit Scheduled',
        'Journey Started',
        'In Progress',
        'Completed',
        'Cancelled',
        'Reported'
      ] &&
      data.bookingSource is string && data.bookingSource.size() <= 40 &&
      data.bookingSource in [
        'Customer Website',
        'Admin Manual',
        'Instagram',
        'WhatsApp',
        'Phone Call',
        'Walk-in'
      ] &&
      data.assignedTeam is list && data.assignedTeam.size() <= 20 &&
      data.createdAt is string && data.createdAt.size() <= 50 &&
      data.updatedAt is string && data.updatedAt.size() <= 50 &&
      (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50)) &&
      (!('reportReason' in data) || (data.reportReason is string && data.reportReason.size() <= 500)) &&
      (!('badgeType' in data) || (data.badgeType is string && data.badgeType.size() <= 20));
    }

    function isValidCustomerLead(data) {
      return data.keys().hasAll([
        'id',
        'customerName',
        'phone',
        'whatsapp',
        'address',
        'eventType',
        'message',
        'source',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'customerName',
        'phone',
        'whatsapp',
        'address',
        'locality',
        'eventType',
        'message',
        'lastBookingId',
        'totalSpend',
        'source',
        'createdAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
      data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
      data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30 &&
      data.whatsapp is string && data.whatsapp.size() <= 30 &&
      data.address is string && data.address.size() <= 500 &&
      (!('locality' in data) || (data.locality is string && data.locality.size() <= 120)) &&
      data.eventType is string && data.eventType.size() <= 60 &&
      data.message is string && data.message.size() <= 1000 &&
      (!('lastBookingId' in data) || (data.lastBookingId is string && data.lastBookingId.size() <= 64)) &&
      (!('totalSpend' in data) || (data.totalSpend is number && data.totalSpend >= 0)) &&
      data.source is string && data.source.size() <= 50 &&
      data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidSettingsDoc(data) {
      return data.keys().hasAll([
        'businessName',
        'makeupBrand',
        'artistName',
        'phonePrimary',
        'address'
      ]) &&
      data.businessName is string && data.businessName.size() <= 150 &&
      data.makeupBrand is string && data.makeupBrand.size() <= 150 &&
      data.artistName is string && data.artistName.size() <= 120 &&
      data.phonePrimary is string && data.phonePrimary.size() <= 40 &&
      data.address is string && data.address.size() <= 500;
    }

    function isValidServiceDoc(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'category',
        'description',
        'image',
        'isPackage'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 80 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
      data.category is string && data.category.size() <= 80 &&
      data.description is string && data.description.size() <= 1500 &&
      data.image is string && data.image.size() <= 500000 &&
      data.isPackage is bool &&
      (!('price' in data) || data.price == null || (data.price is number && data.price >= 0)) &&
      (!('originalPrice' in data) || data.originalPrice == null || (data.originalPrice is number && data.originalPrice >= 0));
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll([
        'id',
        'name',
        'role',
        'phone',
        'active'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 80 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      data.role is string && data.role.size() >= 1 && data.role.size() <= 80 &&
      data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40 &&
      data.active is bool &&
      (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 80)) &&
      (!('password' in data) || data.password == null || (data.password is string && data.password.size() <= 120)) &&
      (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidGalleryDoc(data) {
      return data.keys().hasAll([
        'id',
        'url',
        'alt',
        'category'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 80 &&
      data.url is string && data.url.size() >= 1 && data.url.size() <= 500000 &&
      data.alt is string && data.alt.size() <= 300 &&
      data.category is string && data.category.size() <= 80;
    }

    // 4. Collection Rules
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId);
      allow list: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming()) && incoming().id == bookingId;
      allow update: if isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(bookingId);
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId);
      allow list: if true;
      allow create: if isValidId(customerId) && isValidCustomerLead(incoming()) && incoming().id == customerId;
      allow update: if isValidId(customerId) &&
        isValidCustomerLead(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isValidId(customerId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId) && isValidSettingsDoc(incoming());
    }

    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create, update: if isValidId(serviceId) && isValidServiceDoc(incoming()) && incoming().id == serviceId;
      allow delete: if isValidId(serviceId);
    }

    match /team/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create, update: if isValidId(memberId) && isValidTeamMember(incoming()) && incoming().id == memberId;
      allow delete: if isValidId(memberId);
    }

    match /gallery/{imageId} {
      allow get: if isValidId(imageId);
      allow list: if true;
      allow create, update: if isValidId(imageId) && isValidGalleryDoc(incoming()) && incoming().id == imageId;
      allow delete: if isValidId(imageId);
    }
  }
}
